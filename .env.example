# ─── Database (Supabase PostgreSQL) ───────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
# Use the transaction pooler (port 6543) or direct (5432) URL from Supabase.
DATABASE_URL=

# ─── FastAPI (Railway / local) ────────────────────────────────
SECRET_KEY=
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── ML model ─────────────────────────────────────────────────
MODEL_PATH=./models/categorizer.pkl
MAX_FILE_SIZE_MB=10

# ─── Next.js local dev proxy (optional) ───────────────────────
# Used by frontend/next.config.js rewrites when running npm run dev.
API_PROXY_URL=http://127.0.0.1:8000

# ─── Frontend (Vercel / local) ────────────────────────────────
# Local dev: leave NEXT_PUBLIC_API_URL unset to use Next.js /api proxy.
# Production (Vercel): set to your Railway public URL (no trailing slash).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Finance Tracker
