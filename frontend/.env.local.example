# Local development — copy to frontend/.env.local
#
# Leave NEXT_PUBLIC_API_URL unset so the browser uses same-origin /api
# (proxied to the backend via next.config.js → API_PROXY_URL).
#
# NEXT_PUBLIC_API_URL=

# Optional: override backend target for Next.js rewrites (default http://127.0.0.1:8000)
API_PROXY_URL=http://127.0.0.1:8000

# Production only — your Railway backend URL:
# NEXT_PUBLIC_API_URL=https://your-app.up.railway.app

NEXT_PUBLIC_APP_NAME=Finance Tracker
